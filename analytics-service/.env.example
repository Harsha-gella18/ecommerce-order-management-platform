# Copy to .env in this folder (analytics-service/.env). It overrides any parent .env.

# If mongodb+srv fails with "DNS query name does not exist" on school/corporate Wi‑Fi, set this (or fix Windows DNS).
# The analytics app applies it to dnspython before connecting. You can also put it in the platform root .env.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# MongoDB Atlas: paste your connection string from Atlas → Connect → Drivers.
# Use a user with read/write on the target DB. Special characters in the password must be URL-encoded.
# Put your database name in the path (before ?), e.g. ...mongodb.net/analytics_db?retryWrites=true&w=majority
ANALYTICS_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/analytics_db?retryWrites=true&w=majority

# Optional: same variable name the rest of the platform may use
# MONGODB_URI=mongodb+srv://...

# Local MongoDB (only if you run mongod on this machine):
# ANALYTICS_MONGODB_URI=mongodb://127.0.0.1:27017/analytics_db

# Live admin charts read real orders from the same cluster (same URI pattern as order-service):
# ORDER_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/order_db?retryWrites=true&w=majority
